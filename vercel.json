{
  "buildCommand": "cd landing && npm run build",
  "outputDirectory": "landing/dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" }
    ]}
  ]
}
