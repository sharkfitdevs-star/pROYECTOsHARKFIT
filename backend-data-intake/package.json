{
  "name": "vendify-backend-intake",
  "version": "1.0.0",
  "description": "Backend para ingesta de datos reales en Prototipo Gestionador de Ventas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/worker.js",
    "verify": "node verify-config.js",
    "prestart": "node verify-config.js",
    "create-owner": "node create-owner.js",
    "test": "cross-env NODE_ENV=test jest --coverage",
    "test:one": "cross-env NODE_ENV=test jest tests/settings.routes.test.js --runInBand --detectOpenHandles",
    "migrate:sqlite-to-mongo": "echo \"DEPRECATED: sqlite migration removed; use web/API ingestion\"",
    "seed": "node src/scripts/seedData.js",
    "evo-proxy": "node src/evo-w12-proxy.js",
    "evo-add-credentials": "node scripts/add-evo-credentials.js",
    "evo-encrypt-token": "node scripts/encrypt-token.js",
    "setup": "node scripts/setup-universal-api.js",
    "extract": "node src/index.js",
    "extract-all": "node src/index.js --all",
    "migrate:legacy-importid": "node scripts/migrations/assignLegacyImportId.js"
  },
  "type": "commonjs",
  "keywords": [
    "crm",
    "dashboard",
    "data-intake",
    "sync"
  ],
  "author": "Vendify Team",
  "license": "MIT",
  "dependencies": {
    "agenda": "^4.4.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "http": "^0.0.1-security",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^7.1.0",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "socket.io": "^4.7.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^8.12.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^ioredis$": "<rootDir>/tests/__mocks__/ioredis.js"
    }
  },
  "optionalDependencies": {
    "@sendgrid/mail": "^7.7.0",
    "mailgun-js": "^0.22.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
