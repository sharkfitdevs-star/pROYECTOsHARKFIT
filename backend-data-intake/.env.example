# ===================================
# STAGE 4 - EVO5 DATA INTAKE SERVICE
# ===================================

# ─── SERVIDOR ───
PORT=3005
NODE_ENV=development

# ─── EVO5 CONFIGURACIÓN ───
EVO_BASE_URL=https://evo-integracao-api.w12app.com.br

# Para usar desde cliente, necesitas:
# - DNS: Tu cuenta/empresa en EVO5
# - TOKEN: Tu API token generado en EVO5

# Ejemplo (NO guardes credenciales aquí en producción):
# EVO_DNS=tu-empresa
# EVO_TOKEN=tu-token-evo5

# ─── DJANGO CONFIGURACIÓN ───
DJANGO_BASE_URL=http://localhost:8000/api
DJANGO_JWT_TOKEN=tu-token-jwt-django

# Obtén este token haciendo login en Django:
# POST http://localhost:8000/api/usuarios/login/
# {"username": "admin", "password": "admin123"}

# ─── POLLING ───
POLL_MS=10000

# Cada cuántos milisegundos se sincronizan datos
# 10000 = 10 segundos
# 5000 = 5 segundos
# 60000 = 1 minuto

# SQLite only (no external DB variables required)

# ─── SEGURIDAD ───
# El servicio no firma tokens, solo los verifica.
# Debe recibir el mismo valor que users-microservice usa para firmar.
# Se prefiere la variable JWT_ACCESS_SECRET; ACCESS_TOKEN_SECRET y JWT_SECRET
# funcionan como fallbacks temporales.
JWT_ACCESS_SECRET=valor_igual_que_en_users_microservice

# (JWT_SECRET se mantiene como alias por compatibilidad interna,
# pero no debe usarse en producción)
JWT_SECRET=valor_igual_que_en_users_microservice
JWT_EXPIRATION=24h

# clave para permitir endpoints internos (mismo valor que en users-microservice)
INTERNAL_API_KEY=tu-internal-key-aqui

# Nota: no se utiliza issuer/audience por ahora; si los añade, deben coincidir
# exactamente entre ambos servicios. Ningún algoritmo se especifica explícitamente
# (por defecto HS256).  Los tokens expirados se informan con error TOKEN_EXPIRED.

# ─── INTEGRACIONES EXTERNAS ───

# EVO
EVO_BASE_URL=https://api.evo.com
EVO_API_KEY=tu-api-key-evo
EVO_WEBHOOK_SECRET=secret-para-validar-firma

# ===================================
# EVO W12 PROXY (MongoDB)
# ===================================

# ─── DATABASE (MongoDB) ───
# Connection string for MongoDB used by the intake service and Agenda persistence
MONGODB_URI=mongodb://localhost:27017/sharkfit

# ─── SECURITY ───
# Generate a 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_key_here_replace_this_value_now

# ─── SYNC CONFIGURATION ───
# How often to sync with EVO API (in minutes)
SYNC_INTERVAL_MINUTES=15

# ─── API CONFIGURATION ───
# EVO W12 API Base URL (usually no need to change)
EVO_BASE_URL=https://evo-integracao-api.w12app.com.br

# W12
W12_BASE_URL=https://api.w12app.com
W12_API_KEY=tu-api-key-w12

# ─── OPCIONALES ───

# Redis (para queues con Bull)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (Agenda persistence)
MONGODB_URI=mongodb://localhost:27017/sharkfit
AGENDA_ENABLED=false
AGENDA_COLLECTION=agendaJobs

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15

# Upload limits
MAX_FILE_SIZE_MB=50
