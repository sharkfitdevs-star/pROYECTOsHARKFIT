{
  "id": "api-web",
  "name": "Website extractor (web + API + XLSX)",
  "type": "rest",
  "description": "Extractor genérico para recopilar datos directamente desde la web (API si existe) o páginas HTML. Soporta fallback a parsing HTML y consumo de archivos XLSX vía upload.",
  "baseURL": "${WEB_BASE_URL}",
  "auth": {
    "type": "bearer",
    "token": "${WEB_API_TOKEN}"
  },
  "endpoints": [
    {
      "path": "/api/sales",
      "dataPath": "items",
      "fields": "*",
      "dataType": "ventas"
    },
    {
      "path": "/api/prospects",
      "dataPath": "items",
      "fields": "*",
      "dataType": "prospectos"
    },
    {
      "path": "/access-logs",
      "dataPath": "records",
      "fields": "*",
      "dataType": "accesos"
    },
    {
      "path": "/contacts",
      "dataPath": "items",
      "fields": "*",
      "dataType": "contacts"
    }
  ]
}
