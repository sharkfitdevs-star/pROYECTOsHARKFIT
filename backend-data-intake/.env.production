# ===================================
# PRODUCCIÓN - SharkFit Backend
# ===================================

# ─── SERVIDOR ───
PORT=8000
NODE_ENV=production

# ─── MONGODB (MongoDB Atlas - Producción) ───
# Reemplaza con tu connection string real de producción
MONGODB_URI=mongodb+srv://sharkfit:<db_password>@cluster0.kxa73ub.mongodb.net/sharkfit?retryWrites=true&w=majority

# ─── AUTENTICACIÓN JWT ───
# ⚠️ CRÍTICO: Estos secrets YA fueron generados con crypto.randomBytes(64)
# Cópialos del .env de desarrollo o genera nuevos si prefieres diferentes valores en prod
JWT_SECRET=32ed0605dd1cb4fa0eda9b9c22df6d6d83297dc66f4408b76ee873aa4421bb2b9d14e41ad738c2dc89d58adcf95bcece77aa3bafcb5105a5e0f54cd9ccb96070
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=5a00e4cb9f75a5387cfd77a89cc0d473641aa524f2d83de77d1d1ce3c7942629676fb0f60ac648aa74b286c64bcc779bad56bc0f5a98ac3a1daac99b83a44c2d
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE=refreshToken

# Seguridad de cookies - PRODUCCIÓN
# COOKIE_SAMESITE: strict | lax | none
# COOKIE_SECURE: true | false
# 
# ⚠️ CRÍTICO: SameSite=none REQUIERE Secure=true (o navegador ignora la cookie)
# 
# Configuraciones recomendadas:
# - Frontend y Backend en MISMO dominio (o subdominios): COOKIE_SAMESITE=lax, COOKIE_SECURE=true
# - Frontend y Backend en dominios DIFERENTES: COOKIE_SAMESITE=none, COOKIE_SECURE=true (requiere HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
REFRESH_COOKIE_MAX_AGE_MS=604800000

# Política de login
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# Registro de staff - PRODUCCIÓN
ALLOW_PUBLIC_REGISTER=false
REQUIRE_EMAIL_VERIFICATION=true

# ─── SEED OWNER (Usuario inicial automático) ───
# ⚠️ CRÍTICO: Configura TU PROPIA contraseña de producción aquí
# 
# Esta password se usa SOLO para crear el primer usuario owner
# Requisitos:
#   - Mínimo 16 caracteres
#   - Combinar mayúsculas, minúsculas, números y símbolos
#   - NO reutilices passwords de otros servicios
# 
# Ejemplo de password segura: kJ#8mN$pL2@qR5tX9vW!zC7bD4fG6h
SEED_OWNER_EMAIL=admin@tuempresa.com
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRSTNAME=Admin
SEED_OWNER_LASTNAME=Principal
SEED_OWNER_USERNAME=admin

# ─── CORS ───
# ⚠️ REEMPLAZA con tu dominio de frontend en producción (sin trailing slash)
CORS_ORIGIN=https://dashboard.sharkfit.com

# ─── FRONTEND URL ───
# URL del frontend para enlaces en emails (sin trailing slash)
FRONTEND_URL=https://dashboard.sharkfit.com

# ─── EMAIL CONFIGURACIÓN ───
# Proveedor: sendgrid | mailgun
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@sharkfit.com

# SendGrid (recomendado - gratis hasta 100 emails/día)
SENDGRID_API_KEY=SG.xxxxx_REEMPLAZAR_CON_TU_API_KEY

# Mailgun (alternativa - gratis hasta 5000 emails/mes)
# MAILGUN_API_KEY=xxxxx
# MAILGUN_DOMAIN=mg.sharkfit.com

# ─── EVO5 CRM API ───
EVO_BASE_URL=https://evo-integracao-api.w12app.com.br
# EVO_DNS=tu-empresa-produccion
# EVO_TOKEN=tu-token-evo5-produccion
