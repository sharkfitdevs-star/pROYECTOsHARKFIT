# Backend Django API
API_PORT=8000
API_HOST=0.0.0.0

# Frontend Vite
FRONTEND_PORT=5173

# Landing Page
LANDING_PORT=3000

# Environment
NODE_ENV=development
PYTHON_ENV=development
