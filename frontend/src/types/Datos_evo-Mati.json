{
  "name": "Datos_EVO",
  "type": "object",
  "description": "Almacena datos sincronizados de la API de Evo5",
  "properties": {
    "tipo_evo5": {
      "type": "string",
      "enum": ["cliente", "prospecto", "miembro", "contacto", "grupo"],
      "description": "Tipo de registro en Evo5"
    },
    "evo5_id": {
      "type": "string",
      "description": "ID único de Evo5"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del contacto"
    },
    "whatsapp": {
      "type": "string",
      "description": "Número de WhatsApp - Formato: 56912345678"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email del contacto"
    },
    "telefono": {
      "type": "string",
      "description": "Teléfono principal"
    },
    "ultimo_contacto": {
      "type": "string",
      "format": "date-time",
      "description": "Última interacción con el contacto"
    },
    "estado_evo5": {
      "type": "string",
      "enum": ["activo", "inactivo", "bloqueado", "cancelado", "sin_contacto"],
      "default": "activo",
      "description": "Estado del contacto en Evo5"
    },
    "tipo_miembro": {
      "type": "string",
      "enum": ["prepago", "suscripcion", "permanente", "cortesia", "otro"],
      "description": "Tipo de membresía del contacto"
    },
    "fecha_vencimiento_evo5": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento de la membresía"
    },
    "metadata": {
      "type": "object",
      "description": "Campo flexible para datos extra de Evo5"
    },
    "datos_raw": {
      "type": "object",
      "description": "Respuesta original completa de Evo5"
    },
    "fecha_sincronizacion": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de la última sincronización"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "¿Sincronizando? (default: true)"
    }
  },
  "required": ["tipo_evo5", "evo5_id", "nombre"]
}