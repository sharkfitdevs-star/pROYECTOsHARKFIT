{
  "name": "Checklist_Asignados",
  "type": "object",
  "properties": {
    "plantilla_id": {
      "type": "string",
      "entity": "Checklist_Templates",
      "description": "ID de la plantilla base"
    },
    "usuario_id": {
      "type": "string",
      "entity": "Staff",
      "description": "ID del usuario asignado"
    },
    "fecha_asignacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha para la cual se asigna el checklist"
    },
    "sede_id": {
      "type": "string",
      "entity": "Sucursales",
      "description": "Sede donde se ejecutará el checklist"
    },
    "turno": {
      "type": "string",
      "enum": ["mañana", "tarde", "noche"],
      "description": "Turno de trabajo"
    },
    "fecha_hora_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora real de inicio del checklist"
    },
    "fecha_hora_finalizacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora real de finalización del checklist"
    },
    "estado": {
      "type": "string",
      "enum": ["pendiente", "en_progreso", "completado", "vencido", "omitido"],
      "default": "pendiente",
      "description": "Estado actual del checklist"
    },
    "porcentaje_completitud": {
      "type": "number",
      "default": 0,
      "description": "Porcentaje de items completados (0-100)"
    },
    "items_completados": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de items completados"
    },
    "items_totales": {
      "type": "number",
      "description": "Cantidad total de items en el checklist"
    },
    "items_obligatorios_pendientes": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de items obligatorios aún pendientes"
    },
    "genero_alertas": {
      "type": "boolean",
      "default": false,
      "description": "Si este checklist generó alertas"
    },
    "motivo_omision": {
      "type": "string",
      "description": "Razón por la cual se omitió el checklist (si aplica)"
    },
    "notas": {
      "type": "string",
      "description": "Notas generales sobre la ejecución del checklist"
    }
  },
  "required": ["plantilla_id", "usuario_id", "fecha_asignacion", "sede_id"]
}