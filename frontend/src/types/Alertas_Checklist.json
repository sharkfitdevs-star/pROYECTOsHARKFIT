{
  "name": "Alertas_Checklist",
  "type": "object",
  "properties": {
    "checklist_asignado_id": {
      "type": "string",
      "entity": "Checklist_Asignados",
      "description": "ID del checklist que generó la alerta"
    },
    "tipo_alerta": {
      "type": "string",
      "enum": ["retraso_inicio", "no_completado", "item_omitido", "patron_recurrente", "tiempo_excedido"],
      "description": "Tipo de alerta generada"
    },
    "nivel_severidad": {
      "type": "string",
      "enum": ["info", "warning", "critical"],
      "default": "warning",
      "description": "Nivel de severidad de la alerta"
    },
    "usuario_afectado_id": {
      "type": "string",
      "entity": "Staff",
      "description": "Usuario que generó la alerta"
    },
    "supervisor_notificado_id": {
      "type": "string",
      "entity": "Staff",
      "description": "Supervisor que fue notificado"
    },
    "fecha_hora_generacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de generación de la alerta"
    },
    "estado_alerta": {
      "type": "string",
      "enum": ["activa", "resuelta", "escalada", "ignorada"],
      "default": "activa",
      "description": "Estado actual de la alerta"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada de la alerta"
    },
    "accion_tomada": {
      "type": "string",
      "description": "Acción tomada para resolver la alerta"
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de resolución de la alerta"
    },
    "resuelto_por_id": {
      "type": "string",
      "entity": "Staff",
      "description": "Usuario que resolvió la alerta"
    },
    "requiere_seguimiento": {
      "type": "boolean",
      "default": false,
      "description": "Si requiere seguimiento adicional"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales sobre la alerta"
    }
  },
  "required": ["checklist_asignado_id", "tipo_alerta", "usuario_afectado_id"]
}