{
  "name": "Tareas_RS",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "Título de la tarea"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada de la tarea"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "administrativa", 
        "comercial", 
        "seguimiento", 
        "operativa",
        "baja_programada",
        "cliente_riesgo",
        "renovacion_vencida",
        "deudor",
        "onboarding_cliente_nuevo",
        "nps_cruzado",
        "renovacion_prepago",
        "boletas_electronicas",
        "reintegros_pendientes"
      ],
      "description": "Tipo de tarea"
    },
    "prioridad": {
      "type": "string",
      "enum": ["baja", "media", "alta", "urgente"],
      "default": "media",
      "description": "Prioridad de la tarea"
    },
    "fecha_limite": {
      "type": "string",
      "format": "date",
      "description": "Fecha límite para completar la tarea"
    },
    "estado": {
      "type": "string",
      "enum": ["pendiente", "en_proceso", "completada", "cancelada"],
      "default": "pendiente",
      "description": "Estado actual de la tarea"
    },
    "responsable": {
      "type": "string",
      "relation": "Staff",
      "description": "Staff responsable de la tarea"
    },
    "sede": {
      "type": "string",
      "relation": "Sucursales",
      "description": "Sede a la que pertenece la tarea"
    },
    "cliente": {
      "type": "string",
      "relation": "Clientes",
      "description": "Cliente relacionado (opcional)"
    },
    "fecha_completada": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se completó la tarea"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales sobre la tarea"
    },
    "es_recurrente": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la tarea es recurrente"
    },
    "frecuencia_recurrencia": {
      "type": "string",
      "enum": ["diaria", "semanal", "mensual"],
      "description": "Frecuencia de recurrencia de la tarea"
    },
    "dias_recurrencia": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Días de la semana para recurrencia semanal (0=Domingo, 1=Lunes, ..., 6=Sábado) o día del mes para recurrencia mensual"
    },
    "tarea_padre_id": {
      "type": "string",
      "description": "ID de la tarea padre si es una instancia de tarea recurrente"
    }
  },
  "required": ["titulo", "tipo", "prioridad", "fecha_limite", "responsable", "sede"]
}