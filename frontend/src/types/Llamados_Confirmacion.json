{
  "name": "Llamados_Confirmacion",
  "type": "object",
  "properties": {
    "cliente": {
      "type": "string",
      "relation": "Clientes",
      "description": "Cliente a contactar"
    },
    "motivo": {
      "type": "string",
      "enum": ["confirmacion_asistencia", "renovacion", "seguimiento_nps", "reactivacion", "otro"],
      "description": "Motivo del llamado"
    },
    "fecha_programada": {
      "type": "string",
      "format": "date",
      "description": "Fecha programada para el llamado"
    },
    "estado": {
      "type": "string",
      "enum": ["pendiente", "realizado", "no_contesto", "reagendado", "cancelado"],
      "default": "pendiente",
      "description": "Estado del llamado"
    },
    "responsable": {
      "type": "string",
      "relation": "Staff",
      "description": "Staff responsable del llamado"
    },
    "sede": {
      "type": "string",
      "relation": "Sucursales",
      "description": "Sede del cliente"
    },
    "fecha_realizado": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se realizó el llamado"
    },
    "resultado": {
      "type": "string",
      "description": "Resultado del llamado"
    },
    "proxima_accion": {
      "type": "string",
      "description": "Próxima acción a tomar"
    },
    "notas": {
      "type": "string",
      "description": "Notas del llamado"
    }
  },
  "required": ["cliente", "motivo", "fecha_programada", "responsable", "sede"]
}