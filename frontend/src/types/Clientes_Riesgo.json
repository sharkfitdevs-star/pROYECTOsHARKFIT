{
  "name": "Clientes_Riesgo",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente (relación a Clientes)"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "cliente_whatsapp": {
      "type": "string",
      "description": "WhatsApp del cliente"
    },
    "sede_id": {
      "type": "string",
      "description": "ID de la sede (relación a Sucursales)"
    },
    "fecha_identificacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se identificó el riesgo"
    },
    "motivo_riesgo": {
      "type": "string",
      "enum": ["Baja programada", "NPS bajo", "Deuda", "No uso", "Queja", "Otro"],
      "description": "Motivo por el cual está en riesgo"
    },
    "detalle_motivo": {
      "type": "string",
      "description": "Detalle específico del motivo"
    },
    "nivel_riesgo": {
      "type": "string",
      "enum": ["Bajo", "Medio", "Alto", "Crítico"],
      "default": "Medio",
      "description": "Nivel de riesgo de pérdida"
    },
    "estado": {
      "type": "string",
      "enum": ["Identificado", "En gestión", "Contactado", "Recuperado", "Perdido"],
      "default": "Identificado",
      "description": "Estado de la gestión de retención"
    },
    "fue_contactado": {
      "type": "boolean",
      "default": false,
      "description": "Si fue contactado por retención"
    },
    "fecha_contacto": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del contacto"
    },
    "resultado_contacto": {
      "type": "string",
      "description": "Resultado del contacto realizado"
    },
    "accion_tomada": {
      "type": "string",
      "description": "Acción tomada para retener al cliente"
    },
    "fecha_seguimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha programada para seguimiento"
    },
    "responsable_retencion": {
      "type": "string",
      "description": "Staff responsable de retención (relación a Staff)"
    },
    "baja_programada_id": {
      "type": "string",
      "description": "ID de baja programada si aplica (relación a Bajas_Programadas)"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": ["cliente_id", "fecha_identificacion", "motivo_riesgo", "nivel_riesgo", "estado"]
}