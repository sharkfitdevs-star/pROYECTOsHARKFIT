{
  "name": "Prospectos",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre completo del prospecto"
    },
    "rut": {
      "type": "string",
      "description": "RUT del prospecto"
    },
    "correo": {
      "type": "string",
      "format": "email",
      "description": "Correo electrónico del prospecto"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento del prospecto"
    },
    "edad": {
      "type": "number",
      "description": "Edad calculada automáticamente en base a fecha de nacimiento"
    },
    "objetivos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Bajar de peso", "Aumentar masa muscular", "Distracción", "Tonificar", "Otros"]
      },
      "description": "Objetivos del prospecto (puede seleccionar múltiples)"
    },
    "clase_asistira": {
      "type": "string",
      "description": "ID de la clase a la que asistirá (relación a Clases)"
    },
    "whatsapp": {
      "type": "string",
      "description": "Número de WhatsApp del prospecto"
    },
    "fecha_ingreso": {
      "type": "string",
      "format": "date",
      "description": "Fecha de ingreso del prospecto al sistema"
    },
    "sede": {
      "type": "string",
      "description": "ID de la sede asignada (relación a Sucursales)"
    },
    "vendedor_asignado": {
      "type": "string",
      "description": "ID del vendedor que gestiona al prospecto (relación a Staff)"
    },
    "tipo_invitacion": {
      "type": "string",
      "enum": ["Invitación", "Promesa de compra", "Venta online"],
      "description": "Tipo de invitación del prospecto"
    },
    "fecha_visita": {
      "type": "string",
      "format": "date",
      "description": "Fecha de asistencia programada (opcional)"
    },
    "fecha_compromiso": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del compromiso de compra (cuando el prospecto indica que comprará en una fecha específica)"
    },
    "fecha_ingreso_nps": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que el prospecto ingresó a estado NPS Online (se establece una sola vez y no se modifica para calcular días en NPS)"
    },
    "estado_pipeline": {
      "type": "string",
      "enum": ["Agendado", "Asistió", "No asistió", "Reagendado", "Compró (en sede)", "Compró (online)", "No compró", "Perdido", "No califica", "Compromiso de compra", "NPS Online", "NPS Cruzados", "Descartado"],
      "default": "Agendado",
      "description": "Estado actual en el pipeline de ventas"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales sobre el prospecto"
    }
  },
  "required": ["nombre", "whatsapp", "sede", "tipo_invitacion"]
}