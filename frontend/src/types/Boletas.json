{
  "name": "Boletas",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente (relación a Clientes)"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "venta_id": {
      "type": "string",
      "description": "ID de la venta asociada (relación a Ventas)"
    },
    "sede_id": {
      "type": "string",
      "description": "ID de la sede (relación a Sucursales)"
    },
    "monto": {
      "type": "number",
      "description": "Monto de la boleta"
    },
    "fecha_venta": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la venta"
    },
    "estado": {
      "type": "string",
      "enum": ["Pendiente", "Emitida", "Anulada"],
      "default": "Pendiente",
      "description": "Estado de la boleta"
    },
    "numero_boleta": {
      "type": "string",
      "description": "Número de la boleta emitida"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de emisión de la boleta"
    },
    "emitida_por": {
      "type": "string",
      "description": "Staff que emitió la boleta (relación a Staff)"
    },
    "rut_cliente": {
      "type": "string",
      "description": "RUT del cliente para la boleta"
    },
    "razon_anulacion": {
      "type": "string",
      "description": "Razón de anulación si aplica"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": ["cliente_id", "monto", "fecha_venta", "estado"]
}