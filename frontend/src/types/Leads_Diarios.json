{
  "name": "Leads_Diarios",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del registro de leads"
    },
    "sede": {
      "type": "string",
      "description": "ID de la sede (relación a Sucursales)"
    },
    "turno": {
      "type": "string",
      "enum": ["Mañana", "Tarde", "Noche"],
      "description": "Turno del día"
    },
    "vendedor": {
      "type": "string",
      "description": "ID del vendedor (relación a Staff)"
    },
    "leads_totales": {
      "type": "number",
      "description": "Número total de leads del día"
    },
    "no_agendados": {
      "type": "number",
      "description": "Número de leads no agendados"
    },
    "invitacion": {
      "type": "number",
      "description": "Número de agendados tipo invitación"
    },
    "promesa_compra": {
      "type": "number",
      "description": "Número de agendados tipo promesa de compra"
    },
    "venta_online": {
      "type": "number",
      "description": "Número de agendados tipo venta online"
    }
  },
  "required": ["fecha", "sede", "turno", "vendedor", "leads_totales", "no_agendados", "invitacion", "promesa_compra", "venta_online"]
}