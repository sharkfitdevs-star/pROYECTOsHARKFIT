{
  "name": "Contratos",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente (relación a Clientes)"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "cliente_whatsapp": {
      "type": "string",
      "description": "WhatsApp del cliente"
    },
    "sede_id": {
      "type": "string",
      "description": "ID de la sede (relación a Sucursales)"
    },
    "venta_id": {
      "type": "string",
      "description": "ID de la venta asociada (relación a Ventas)"
    },
    "plan": {
      "type": "string",
      "description": "Plan contratado"
    },
    "fecha_venta": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la venta"
    },
    "estado": {
      "type": "string",
      "enum": ["Pendiente", "Firmado", "Rechazado"],
      "default": "Pendiente",
      "description": "Estado del contrato"
    },
    "fecha_firma": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de firma del contrato"
    },
    "metodo_firma": {
      "type": "string",
      "enum": ["Presencial", "Digital", "Email"],
      "description": "Método utilizado para la firma"
    },
    "url_documento": {
      "type": "string",
      "description": "URL del documento firmado"
    },
    "recibido_por": {
      "type": "string",
      "description": "Staff que recibió el contrato (relación a Staff)"
    },
    "dias_pendiente": {
      "type": "number",
      "description": "Días desde la venta sin firmar"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": ["cliente_id", "fecha_venta", "estado"]
}